---
import { getCollection } from "astro:content";
import { getCategoryCounts } from "../pages/blog/blog";
import SidebarHeader from "./SidebarHeader.astro";
const pages = await getCollection("pages");
---

<SidebarHeader>Pages</SidebarHeader>
<ul>
  {
    pages
      .sort((a, b) => {
        if (a.data.priority || b.data.priority) {
          return (a.data.priority || 1000) - (b.data.priority || 1000);
        } else {
          return a.data.title.localeCompare(b.data.title);
        }
      })
      .map((page) => {
        const link = page.slug == "index" ? "/" : `/${page.slug}`;
        return (
          <li>
            <a href={link}>{page.data.title}</a>{" "}
          </li>
        );
      })
  }
</ul>

<style>
  ul {
    text-align: left;
    list-style-type: none;
    padding-left: 0;
    padding-top: 0;
    margin-top: 0;
    line-height: 1;
  }

  li {
    display: block;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    margin-right: 1rem;
    text-wrap: nowrap;
  }

  ul ul {
    padding-left: 1rem;
  }
</style>
